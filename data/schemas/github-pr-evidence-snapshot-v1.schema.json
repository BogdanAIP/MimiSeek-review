{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BogdanAIP/MimiSeek-review/data/schemas/github-pr-evidence-snapshot-v1.schema.json",
  "title": "MimiSeek GitHub PR evidence snapshot v1",
  "type": "object",
  "required": [
    "schema_version",
    "authority",
    "repository",
    "pr_number",
    "pull_request",
    "issue_comments",
    "reviews",
    "review_comments",
    "commits",
    "source"
  ],
  "properties": {
    "schema_version": {"const": "github_pr_evidence_snapshot_v1"},
    "authority": {
      "type": "object",
      "required": ["role", "rules"],
      "properties": {
        "role": {"const": "non_authoritative_source_snapshot"},
        "rules": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "pull_request": {"type": "object"},
    "issue_comments": {"type": "array", "items": {"type": "object"}},
    "reviews": {"type": "array", "items": {"type": "object"}},
    "review_comments": {"type": "array", "items": {"type": "object"}},
    "commits": {"type": "array", "items": {"type": "object"}},
    "source": {"type": "object"}
  },
  "additionalProperties": false
}
