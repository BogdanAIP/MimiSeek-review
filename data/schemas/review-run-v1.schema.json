{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Bootstrap-only normalized projection of one authenticated Review Runs workbook row. x-columns defines the stable positional order. Numeric metrics preserve source blanks as null; zero means the source explicitly recorded zero.",
  "maxItems": 21,
  "minItems": 21,
  "prefixItems": [
    {"pattern":"^R[0-9]{3}$","type":"string"},
    {"pattern":"^[^/\\s]+/[^/\\s]+$","type":"string"},
    {"minimum":1,"type":"integer"},
    {"pattern":"^[0-9a-f]{40}$","type":"string"},
    {"pattern":"^[0-9a-f]{40}$","type":"string"},
    {"minLength":1,"type":"string"},
    {"minLength":1,"type":["string","null"]},
    {"enum":["FINDINGS","PASS","ABSTAIN","UNAVAILABLE","FINDINGS_POST_MERGE","RESULT_NOT_RECONSTRUCTED"]},
    {"type":["boolean","null"]},
    {"minimum":0,"type":["integer","null"]},
    {"minimum":0,"type":["integer","null"]},
    {"minimum":0,"type":["integer","null"]},
    {"minimum":0,"type":["integer","null"]},
    {"minimum":0,"type":["integer","null"]},
    {"minimum":0,"type":["integer","null"]},
    {"minimum":0,"type":["integer","null"]},
    {"minLength":1,"type":["string","null"]},
    {"pattern":"^C[0-9]{3}$","type":["string","null"]},
    {"pattern":"^https://github\\.com/[^/\\s]+/[^/\\s]+/pull/[0-9]+$","type":["string","null"]},
    {"minLength":1,"type":["string","null"]},
    {"minimum":2,"type":"integer"}
  ],
  "items": false,
  "title": "MimiSeek bootstrap review-run tuple v1",
  "type": "array",
  "x-bootstrap-source": {"manifest_ref":"data/bootstrap-source.json","sheet":"Review Runs","sheet_row_column":"source_row"},
  "x-record-scope": "authenticated_workbook_bootstrap_only",
  "x-source-projection": {
    "kind": "normalized_semantic_projection",
    "not_column_lossless": true,
    "row_recovery": "data/bootstrap-source.json + source_row identifies the exact authenticated workbook row",
    "omitted_columns": [
      {"name":"PR title","classification":"descriptive_github_metadata","recovery":"resolve the exact source PR"},
      {"name":"Notes","classification":"non_authoritative_source_commentary","recovery":"recover the authenticated workbook row; reconcile any material assertion into governed GitHub provenance before baseline derivation"}
    ]
  },
  "x-columns": ["run_id","repository","pr","base_sha","head_sha","reviewer","review_context","status","valid_run","findings","p1","p2","p3","rejected_candidates","confirmed_findings","rejected_findings","availability","comparison_id","source_url","evidence_confidence","source_row"]
}
