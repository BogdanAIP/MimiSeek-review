{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BogdanAIP/MimiSeek-review/data/schemas/github-pr-reactions-v1.schema.json",
  "title": "GitHub pull request reactions source snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "repository", "pr_number", "reactions", "source"],
  "properties": {
    "schema_version": {"const": "github_pr_reactions_snapshot_v1"},
    "authority": {
      "type": "object",
      "required": ["role", "rules"],
      "properties": {
        "role": {"const": "non_authoritative_source_snapshot"},
        "rules": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "node_id", "content", "created_at", "user"],
        "properties": {
          "id": {"type": ["integer", "null"]},
          "node_id": {"type": ["string", "null"]},
          "content": {"enum": ["+1", "-1", "laugh", "confused", "heart", "hooray", "rocket", "eyes", null]},
          "created_at": {"type": ["string", "null"]},
          "user": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["id", "login", "type"],
            "properties": {
              "id": {"type": ["integer", "null"]},
              "login": {"type": ["string", "null"]},
              "type": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_base", "kind"],
      "properties": {
        "api_base": {"type": "string"},
        "kind": {"const": "issue_reactions_for_pull_request"}
      }
    }
  }
}
